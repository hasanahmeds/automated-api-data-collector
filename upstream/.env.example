# ---------------------------------------------------------------------------
# data-pipeline-etl environment configuration
# Copy to `.env` and adjust. Defaults work out of the box (SQLite, local files).
# ---------------------------------------------------------------------------

# Default sink database (per-pipeline overrides live in the pipeline YAML)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/warehouse
DATABASE_URL=sqlite:///data/pipeline.db

# Where pipeline YAML configs live
# PIPELINES_DIR=config/pipelines
# QUALITY_DIR=config/quality

# Quality gate: pipelines scoring below this abort before load
DEFAULT_QUALITY_THRESHOLD=80

# Scheduler on/off (python -m src.cli schedule)
SCHEDULE_ENABLED=true
